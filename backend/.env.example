# Copia este archivo como .env y completa los valores.
PORT=3001
NODE_ENV=development

# Base de datos local persistente (PGlite)
PGLITE_DIR=./data/aquachile
# Alternativa PostgreSQL (Neon, Supabase, Azure, etc.)
# DATABASE_URL=postgresql://usuario:clave@host:5432/aquachile

# Seguridad JWT (cambia estos valores en producción)
JWT_SECRET=cambia-este-secreto-de-acceso
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Orígenes permitidos del frontend
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# IA Groq — consíguela en https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

MAX_CV_BYTES=5242880
RATE_LIMIT_DISABLED=false
